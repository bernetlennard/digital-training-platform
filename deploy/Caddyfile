# Caddy holt das Zertifikat für {$DOMAIN} bei Let's Encrypt, beendet TLS und leitet
# HTTP automatisch auf HTTPS um (#NFA-7.8).
{
	# Die Firewall lässt nur TCP durch, darum kein HTTP/3 über UDP
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"

	# Frontend und API unter derselben Domain, darum ohne CORS (#NFA-7.18).
	# Swagger UI liegt nicht unter /api und ist damit von aussen nicht erreichbar (#NFA-7.16).
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}
}
